[
  { "id": "start", "type": "dialogue", "text": "Welcome, {player_name}. You have {coins} coins." },
  {
	"type": "choice",
	"options": [
	  { "text": "Ask about coins", "next": "coin_info" },
	  { "text": "Say goodbye", "next": "goodbye" }
	]
  },
  { "id": "coin_info", "type": "dialogue", "text": "You currently have {coins} coins. Keep an eye on your bills." },
  { "id": "goodbye", "type": "dialogue", "text": "Goodbye, {player_name}." },
  { "type": "input", "prompt": "What is your secret code?", "var": "secret_code", "default": "0000" },
  { "type": "dialogue", "text": "You entered: {secret_code}" },
  { "type": "end", "text": "[Dialogue complete]", "exit_text": "Exit dialogue" }
]
